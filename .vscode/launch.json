{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Lazy Workspace Guard",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/remote-core"],
      "outFiles": ["${workspaceFolder}/packages/remote-core/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
