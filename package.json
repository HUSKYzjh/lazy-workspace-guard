{
  "name": "lazy-workspace-guard-repository",
  "version": "0.1.0",
  "private": true,
  "description": "Source repository for the Lazy Workspace Guard extension packages.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "compile": "npm --prefix packages/remote-core run compile && npm --prefix packages/local-bridge run compile",
    "watch": "npm --prefix packages/remote-core run watch",
    "lint": "eslint packages/remote-core/src packages/local-bridge/src --ext .ts",
    "test": "npm run test:core && npm run test:bridge",
    "test:core": "npm --prefix packages/remote-core run test:unit",
    "test:bridge": "npm --prefix packages/local-bridge run compile && node --test packages/local-bridge/out/test/sshConfig.test.js",
    "test:integration": "npm --prefix packages/remote-core run test:integration",
    "package": "npm run package:core",
    "package:core": "npm --prefix packages/remote-core run package",
    "package:bridge": "cd packages/local-bridge && npx --yes @vscode/vsce@2.26.1 package --no-dependencies",
    "package:suite": "cd packages/lazy-workspace-guard && npx --yes @vscode/vsce@2.26.1 package --no-dependencies",
    "package:all": "npm run package:core && npm run package:bridge && npm run package:suite"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  }
}
