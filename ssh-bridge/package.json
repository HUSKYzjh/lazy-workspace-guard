{
  "name": "lazy-workspace-guard-ssh-bridge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "hpc-tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HUSKYzjh/lazy-workspace-guard.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["ssh", "remote-ssh", "hpc"],
  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onCommand:lazyWorkspaceGuardSshBridge.copyProfile"],
  "contributes": {
    "commands": [
      {
        "command": "lazyWorkspaceGuardSshBridge.copyProfile",
        "title": "%command.copyProfile%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./"
  }
}
