{
  "name": "lazy-workspace-guard-remote-core",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "hpc-tools",
  "license": "MIT",
  "icon": "assets/lazy-workspace-guard-remote-core-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HUSKYzjh/lazy-workspace-guard.git"
  },
  "bugs": {
    "url": "https://github.com/HUSKYzjh/lazy-workspace-guard/issues"
  },
  "homepage": "https://github.com/HUSKYzjh/lazy-workspace-guard#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "hpc",
    "remote-ssh",
    "large-workspace",
    "file-watcher"
  ],
  "pricing": "Free",
  "preview": true,
  "galleryBanner": {
    "color": "#123b2a",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:lazyWorkspaceGuard.explorer",
    "onView:lazyWorkspaceGuard.diagnostics",
    "onCommand:lazyWorkspaceGuard.openResource",
    "onCommand:lazyWorkspaceGuard.openResourceToSide",
    "onCommand:lazyWorkspaceGuard.openResourceWith",
    "onCommand:lazyWorkspaceGuard.selectResourceForCompare",
    "onCommand:lazyWorkspaceGuard.compareResourceWithSelected",
    "onCommand:lazyWorkspaceGuard.openResourceTimeline",
    "onCommand:lazyWorkspaceGuard.copyResourceContents",
    "onCommand:lazyWorkspaceGuard.copyResourceName",
    "onCommand:lazyWorkspaceGuard.openResourceTerminal",
    "onCommand:lazyWorkspaceGuard.showResourceProperties",
    "onCommand:lazyWorkspaceGuard.createResourceFile",
    "onCommand:lazyWorkspaceGuard.createResourceDirectory",
    "onCommand:lazyWorkspaceGuard.renameResource",
    "onCommand:lazyWorkspaceGuard.deleteResource",
    "onCommand:lazyWorkspaceGuard.copyResourcePath",
    "onCommand:lazyWorkspaceGuard.copyResourceRelativePath",
    "onCommand:lazyWorkspaceGuard.copyResourceUri",
    "onCommand:lazyWorkspaceGuard.copySshLocation",
    "onCommand:lazyWorkspaceGuard.copySshDownloadCommand",
    "onCommand:lazyWorkspaceGuard.browseRemoteDirectory",
    "onCommand:lazyWorkspaceGuard.removeRemoteDirectory",
    "onCommand:lazyWorkspaceGuard.refresh",
    "onCommand:lazyWorkspaceGuard.configureSort",
    "onCommand:lazyWorkspaceGuard.excludeFromWatchers",
    "onCommand:lazyWorkspaceGuard.includeFolder",
    "onCommand:lazyWorkspaceGuard.restoreManagedRules",
    "onCommand:lazyWorkspaceGuard.refreshDiagnostics",
    "onCommand:lazyWorkspaceGuard.resetDiagnostics",
    "onCommand:lazyWorkspaceGuard.exportDiagnostics",
    "onCommand:lazyWorkspaceGuard.applyRuleTemplate"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lazyWorkspaceGuard.openResource",
        "title": "%command.openResource%"
      },
      {
        "command": "lazyWorkspaceGuard.openResourceToSide",
        "title": "%command.openResourceToSide%"
      },
      {
        "command": "lazyWorkspaceGuard.openResourceWith",
        "title": "%command.openResourceWith%"
      },
      {
        "command": "lazyWorkspaceGuard.selectResourceForCompare",
        "title": "%command.selectResourceForCompare%"
      },
      {
        "command": "lazyWorkspaceGuard.compareResourceWithSelected",
        "title": "%command.compareResourceWithSelected%"
      },
      {
        "command": "lazyWorkspaceGuard.openResourceTimeline",
        "title": "%command.openResourceTimeline%"
      },
      {
        "command": "lazyWorkspaceGuard.copyResourceContents",
        "title": "%command.copyResourceContents%"
      },
      {
        "command": "lazyWorkspaceGuard.copyResourceName",
        "title": "%command.copyResourceName%"
      },
      {
        "command": "lazyWorkspaceGuard.openResourceTerminal",
        "title": "%command.openResourceTerminal%"
      },
      {
        "command": "lazyWorkspaceGuard.showResourceProperties",
        "title": "%command.showResourceProperties%"
      },
      {
        "command": "lazyWorkspaceGuard.createResourceFile",
        "title": "%command.createResourceFile%"
      },
      {
        "command": "lazyWorkspaceGuard.createResourceDirectory",
        "title": "%command.createResourceDirectory%"
      },
      {
        "command": "lazyWorkspaceGuard.renameResource",
        "title": "%command.renameResource%"
      },
      {
        "command": "lazyWorkspaceGuard.deleteResource",
        "title": "%command.deleteResource%"
      },
      {
        "command": "lazyWorkspaceGuard.copyResourcePath",
        "title": "%command.copyResourcePath%"
      },
      {
        "command": "lazyWorkspaceGuard.copyResourceRelativePath",
        "title": "%command.copyResourceRelativePath%"
      },
      {
        "command": "lazyWorkspaceGuard.copyResourceUri",
        "title": "%command.copyResourceUri%"
      },
      {
        "command": "lazyWorkspaceGuard.copySshLocation",
        "title": "%command.copySshLocation%"
      },
      {
        "command": "lazyWorkspaceGuard.copySshDownloadCommand",
        "title": "%command.copySshDownloadCommand%"
      },
      {
        "command": "lazyWorkspaceGuard.browseRemoteDirectory",
        "title": "%command.browseRemoteDirectory%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "lazyWorkspaceGuard.removeRemoteDirectory",
        "title": "%command.removeRemoteDirectory%",
        "icon": "$(trash)"
      },
      {
        "command": "lazyWorkspaceGuard.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "lazyWorkspaceGuard.excludeFromWatchers",
        "title": "%command.excludeFromWatchers%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "lazyWorkspaceGuard.includeFolder",
        "title": "%command.includeFolder%",
        "icon": "$(eye)"
      },
      {
        "command": "lazyWorkspaceGuard.restoreManagedRules",
        "title": "%command.restoreManagedRules%",
        "icon": "$(history)"
      },
      {
        "command": "lazyWorkspaceGuard.refreshDiagnostics",
        "title": "%command.refreshDiagnostics%",
        "icon": "$(refresh)"
      },
      {
        "command": "lazyWorkspaceGuard.resetDiagnostics",
        "title": "%command.resetDiagnostics%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "lazyWorkspaceGuard.exportDiagnostics",
        "title": "%command.exportDiagnostics%",
        "icon": "$(export)"
      },
      {
        "command": "lazyWorkspaceGuard.applyRuleTemplate",
        "title": "%command.applyRuleTemplate%",
        "icon": "$(list-selection)"
      },
      {
        "command": "lazyWorkspaceGuard.configureSort",
        "title": "%command.configureSort%",
        "icon": "$(settings-gear)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "lazyWorkspaceGuard.explorer",
          "name": "%view.explorer%"
        },
        {
          "id": "lazyWorkspaceGuard.diagnostics",
          "name": "%view.diagnostics%"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "lazyWorkspaceGuard.safeRemoteStart",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openLazyExplorer",
            "title": "%walkthrough.step.openView.title%",
            "description": "%walkthrough.step.openView.description%",
            "media": {
              "image": "assets/lazy-workspace-guard-remote-core-icon.png",
              "altText": "%walkthrough.step.openView.altText%"
            },
            "completionEvents": [
              "onView:lazyWorkspaceGuard.explorer"
            ]
          },
          {
            "id": "browseSafely",
            "title": "%walkthrough.step.browse.title%",
            "description": "%walkthrough.step.browse.description%",
            "media": {
              "image": "assets/lazy-workspace-guard-remote-core-icon.png",
              "altText": "%walkthrough.step.browse.altText%"
            },
            "completionEvents": [
              "onCommand:lazyWorkspaceGuard.browseRemoteDirectory"
            ]
          },
          {
            "id": "checkBoundaries",
            "title": "%walkthrough.step.safety.title%",
            "description": "%walkthrough.step.safety.description%",
            "media": {
              "image": "assets/lazy-workspace-guard-remote-core-icon.png",
              "altText": "%walkthrough.step.safety.altText%"
            },
            "completionEvents": [
              "onCommand:lazyWorkspaceGuard.refreshDiagnostics"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lazyWorkspaceGuard.browseRemoteDirectory",
          "when": "view == lazyWorkspaceGuard.explorer",
          "group": "navigation"
        },
        {
          "command": "lazyWorkspaceGuard.refresh",
          "when": "view == lazyWorkspaceGuard.explorer",
          "group": "navigation@2"
        },
        {
          "command": "lazyWorkspaceGuard.restoreManagedRules",
          "when": "view == lazyWorkspaceGuard.explorer",
          "group": "navigation@3"
        },
        {
          "command": "lazyWorkspaceGuard.applyRuleTemplate",
          "when": "view == lazyWorkspaceGuard.explorer",
          "group": "navigation@4"
        },
        {
          "command": "lazyWorkspaceGuard.configureSort",
          "when": "view == lazyWorkspaceGuard.explorer",
          "group": "navigation@5"
        },
        {
          "command": "lazyWorkspaceGuard.refreshDiagnostics",
          "when": "view == lazyWorkspaceGuard.diagnostics",
          "group": "navigation"
        },
        {
          "command": "lazyWorkspaceGuard.resetDiagnostics",
          "when": "view == lazyWorkspaceGuard.diagnostics",
          "group": "navigation@2"
        },
        {
          "command": "lazyWorkspaceGuard.exportDiagnostics",
          "when": "view == lazyWorkspaceGuard.diagnostics",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "lazyWorkspaceGuard.openResource",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile",
          "group": "1_open@1"
        },
        {
          "command": "lazyWorkspaceGuard.openResourceToSide",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile",
          "group": "1_open@2"
        },
        {
          "command": "lazyWorkspaceGuard.openResourceWith",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile",
          "group": "1_open@3"
        },
        {
          "command": "lazyWorkspaceGuard.selectResourceForCompare",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile",
          "group": "1_open@4"
        },
        {
          "command": "lazyWorkspaceGuard.compareResourceWithSelected",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile && lazyWorkspaceGuard.hasCompareSource",
          "group": "1_open@5"
        },
        {
          "command": "lazyWorkspaceGuard.openResourceTimeline",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile",
          "group": "1_open@6"
        },
        {
          "command": "lazyWorkspaceGuard.copyResourceContents",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile",
          "group": "2_clipboard@1"
        },
        {
          "command": "lazyWorkspaceGuard.copyResourcePath",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder|File)/",
          "group": "2_clipboard@2"
        },
        {
          "command": "lazyWorkspaceGuard.copyResourceRelativePath",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder|File)/",
          "group": "2_clipboard@3"
        },
        {
          "command": "lazyWorkspaceGuard.copyResourceUri",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder|File)/",
          "group": "2_clipboard@4"
        },
        {
          "command": "lazyWorkspaceGuard.copySshLocation",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder|File)/",
          "group": "2_clipboard@5"
        },
        {
          "command": "lazyWorkspaceGuard.copySshDownloadCommand",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFile",
          "group": "2_clipboard@6"
        },
        {
          "command": "lazyWorkspaceGuard.copyResourceName",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder|File)/",
          "group": "2_clipboard@7"
        },
        {
          "command": "lazyWorkspaceGuard.createResourceFile",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder)/",
          "group": "3_create@1"
        },
        {
          "command": "lazyWorkspaceGuard.createResourceDirectory",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder)/",
          "group": "3_create@2"
        },
        {
          "command": "lazyWorkspaceGuard.renameResource",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(Folder|SafeRemoteFolder|File)/",
          "group": "4_mutation@1"
        },
        {
          "command": "lazyWorkspaceGuard.deleteResource",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(Folder|SafeRemoteFolder|File)/",
          "group": "4_mutation@2"
        },
        {
          "command": "lazyWorkspaceGuard.removeRemoteDirectory",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceSafeRoot",
          "group": "5_safeRoot"
        },
        {
          "command": "lazyWorkspaceGuard.excludeFromWatchers",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFolder",
          "group": "6_workspace@1"
        },
        {
          "command": "lazyWorkspaceGuard.includeFolder",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem == resourceFolder",
          "group": "6_workspace@2"
        },
        {
          "command": "lazyWorkspaceGuard.refresh",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(Folder|SafeRemoteFolder|WorkspaceFolder|SafeRoot)/",
          "group": "7_navigation"
        },
        {
          "command": "lazyWorkspaceGuard.openResourceTerminal",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder|File)/",
          "group": "8_actions@1"
        },
        {
          "command": "lazyWorkspaceGuard.showResourceProperties",
          "when": "view == lazyWorkspaceGuard.explorer && viewItem =~ /resource(SafeRoot|WorkspaceFolder|Folder|SafeRemoteFolder|File)/",
          "group": "8_actions@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "lazyWorkspaceGuard.excludePythonAnalysis": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.excludePythonAnalysis.description%"
        },
        "lazyWorkspaceGuard.maximumVisibleDirectoryEntries": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "description": "%configuration.maximumVisibleDirectoryEntries.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && node --test out/test/rules.test.js out/test/metrics.test.js out/test/settingsPlan.test.js out/test/transaction.test.js out/test/directoryPage.test.js out/test/directoryLimitWarning.test.js out/test/directorySort.test.js out/test/localDirectoryPage.test.js out/test/remoteDirectoryPage.test.js out/test/remoteIdentity.test.js out/test/diagnosticSampling.test.js out/test/ruleTemplates.test.js out/test/resourceMutation.test.js out/test/resourceOpen.test.js out/test/manifest.test.js out/test/safeRoots.test.js",
    "test:integration": "npm run compile && node out/test/integration/runTest.js",
    "package": "npx --yes @vscode/vsce@2.26.1 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  }
}
